def findMaxLength(nums):
    """
    :type nums: List[int]
    :rtype: int
    """
    
    first_index={0:-1}
    prefix_sum=0
    longest=0

    for i,num in enumerate(nums):
        prefix_sum += 1 if num ==1 else -1

        if prefix_sum in first_index:
            longest = max(longest, i- first_index[prefix_sum])

        else:
            first_index[prefix_sum] = i

    return longest



print(findMaxLength([0,1]))