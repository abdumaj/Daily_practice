
def productExceptSelf(nums):
    """
    :type nums: List[int]
    :rtype: List[int]
    """
    left=1
    right=1
    product_arr=[1]*len(nums)

    for i in range(len(nums)):
        product_arr[i] *= left
        left*= nums[i]

    for i in range(len(nums)-1,-1,-1):
        product_arr[i] *= right
        right*= nums[i]


    return product_arr

print(productExceptSelf([1,2,3,4]))